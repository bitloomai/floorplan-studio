  "_openings_comment": "Openings are cut INTO a boundary. Each carries its own transmission, which multiplies the boundary's: a curtained window in a glass wall is 0.9 × 0.25. `defaultOpen` matters for doors — an unsensored door, or one whose sensor is dead, draws open, because claiming a door is shut when nothing knows is worse than the reverse.",
  "openingTypes": {
    "door": {
      "label": "Door",
      "transmission": 0.15,
      "defaultOpen": true,
      "render": {
        "style": "swing"
      },
      "props": {
        "w": 2.75,
        "h": 6.75,
        "swing": "in",
        "hinge": "start",
        "leaves": 1,
        "covering": null
      }
    },
    "door_double": {
